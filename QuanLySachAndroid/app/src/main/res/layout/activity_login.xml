<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="36dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_logo_circle"
            android:gravity="center"
            android:text="B"
            android:textColor="@color/white"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Thư viện sách"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Đăng nhập để tiếp tục"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView style="@style/FieldLabel" android:text="Tên đăng nhập" />
        <EditText
            android:id="@+id/edtUsername"
            style="@style/FieldEditText"
            android:hint="Nhập tên đăng nhập"
            android:inputType="text"
            android:singleLine="true" />

        <TextView style="@style/FieldLabel" android:text="Mật khẩu" />
        <EditText
            android:id="@+id/edtPassword"
            style="@style/FieldEditText"
            android:hint="Nhập mật khẩu"
            android:inputType="textPassword"
            android:singleLine="true" />

        <TextView
            android:id="@+id/txtLoginError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/danger"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnLogin"
            style="@style/PrimaryButton"
            android:layout_marginTop="16dp"
            android:text="Đăng nhập" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Tài khoản mẫu: admin / 123456"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
