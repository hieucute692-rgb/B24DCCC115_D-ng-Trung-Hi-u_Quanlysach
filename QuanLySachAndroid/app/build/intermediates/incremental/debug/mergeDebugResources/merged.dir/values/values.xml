<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string-array name="book_categories">
        <item>Văn học</item>
        <item>Khoa học</item>
        <item>Công nghệ</item>
        <item>Kỹ năng sống</item>
        <item>Khác</item>
    </string-array>
    <color name="accent">#FF9800</color>
    <color name="background">#F3F6F7</color>
    <color name="border">#D9E0E2</color>
    <color name="danger">#D32F2F</color>
    <color name="primary">#00796B</color>
    <color name="primary_dark">#004D40</color>
    <color name="primary_light">#E0F2F1</color>
    <color name="text_primary">#212121</color>
    <color name="text_secondary">#757575</color>
    <color name="white">#FFFFFF</color>
    <string name="app_name">Thư viện sách</string>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:navigationBarColor">#202020</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/background</item>
    </style>
    <style name="DangerButton" parent="PrimaryButton">
        <item name="android:background">@drawable/bg_button_danger</item>
    </style>
    <style name="FieldEditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">#8A8A8A</item>
    </style>
    <style name="FieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>
    <style name="PrimaryButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="SecondaryButton" parent="PrimaryButton">
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="android:textColor">@color/primary</item>
    </style>
</resources>